<BuildingDefs>
    
    <!-- ============== 墙壁 ============== -->
    
    <BuildingDef>
        <defName>Building_Wall_Wood</defName>
        <label>木墙</label>
        <description>简单的木质墙壁，提供基本的遮蔽。</description>
        <!-- ThingDef属性 -->
        <category>Building</category>
        <size><x>1</x><y>1</y></size>
        <selectionPriority>10</selectionPriority>
        <selectable>true</selectable>
        <texturePath>Textures/Building/Wall_Wood</texturePath>
        <iconPath>Textures/UI/Icons/Wall_Wood</iconPath>
        <color><r>0.7</r><g>0.55</g><b>0.35</b><a>1.0</a></color>
        <drawSize>1.0</drawSize>
        <renderLayer>100</renderLayer>
        <rotatable>false</rotatable>
        <blockPass>true</blockPass>
        <pathCost>0</pathCost>
        <blockLight>true</blockLight>
        <fillPercent>1.0</fillPercent>
        <maxHitPoints>150</maxHitPoints>
        <destroyable>true</destroyable>
        <flammable>true</flammable>
        <flammability>1.0</flammability>
        <stackLimit>1</stackLimit>
        <mass>50</mass>
        <baseMarketValue>30</baseMarketValue>
        <!-- BuildingDef特有属性 -->
        <buildingType>Wall</buildingType>
        <isWall>true</isWall>
        <isDoor>false</isDoor>
        <doorOpenPassable>false</doorOpenPassable>
        <holdsRoof>true</holdsRoof>
        <canPlaceUnder>false</canPlaceUnder>
        <costs>
            <li><defName>Item_Wood</defName><amount>5</amount></li>
        </costs>
        <workToBuild>100</workToBuild>
        <constructionSkill>Construction</constructionSkill>
        <minSkillLevel>0</minSkillLevel>
        <playerBuildable>true</playerBuildable>
        <blueprintTexturePath>Textures/Building/Wall_Wood_Blueprint</blueprintTexturePath>
        <comfort>0</comfort>
        <beauty>0</beauty>
        <isRest>false</isRest>
        <restEfficiency>1</restEfficiency>
        <isWorkStation>false</isWorkStation>
        <recipeDefNames/>
        <storageCapacity>0</storageCapacity>
        <storageFilter/>
        <powerConsumption>0</powerConsumption>
        <requiresPower>false</requiresPower>
        <isMultiFloor>false</isMultiFloor>
        <floorConnection>0</floorConnection>
    </BuildingDef>
    
