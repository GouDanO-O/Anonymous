        <baseMaxHealth>100</baseMaxHealth>
        <baseMoveSpeed>4.5</baseMoveSpeed>
        <baseWorkSpeed>1.0</baseWorkSpeed>
        <carryCapacity>50</carryCapacity>
        <sightRange>20</sightRange>
        <hasMood>false</hasMood>
        <needsFood>true</needsFood>
        <needsRest>false</needsRest>
        <hungerRate>1.6</hungerRate>
