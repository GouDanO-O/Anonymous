<?xml version="1.0" encoding="utf-8"?>
<!-- PawnKindDefs.xml - 角色种类定义配置 -->
<PawnKindDefs>
    
    <!-- ============== 人类角色 ============== -->
    
    <PawnKindDef>
        <defName>PawnKind_Colonist</defName>
        <label>殖民者</label>
        <description>普通的殖民者，可以进行各种工作和战斗。</description>
        <!-- 基础属性 -->
        <raceType>Human</raceType>
        <playerControlled>true</playerControlled>
        <hostile>false</hostile>
        <wild>false</wild>
        <combatPower>50</combatPower>
        <!-- 外观属性 -->
        <bodyTexturePath>Textures/Pawn/Human/Body</bodyTexturePath>
        <headTexturePath>Textures/Pawn/Human/Head</headTexturePath>
        <drawSize>1.0</drawSize>
        <color><r>1.0</r><g>0.9</g><b>0.8</b><a>1.0</a></color>
        <!-- 属性数值 -->
        <baseMaxHealth>100</baseMaxHealth>
        <baseMoveSpeed>4.5</baseMoveSpeed>
        <baseWorkSpeed>1.0</baseWorkSpeed>
        <carryCapacity>75</carryCapacity>
        <sightRange>25</sightRange>
        <!-- 需求系统 -->
        <hasMood>true</hasMood>
        <needsFood>true</needsFood>
        <needsRest>true</needsRest>
        <hungerRate>1.6</hungerRate>
        <restFallRate>1.0</restFallRate>
        <!-- 战斗属性 -->
        <meleeDPS>5</meleeDPS>
        <armor>0</armor>
        <dodgeChance>0.05</dodgeChance>
        <defaultWeaponDefName></defaultWeaponDefName>
        <!-- 工作能力 -->
        <allowedWorkTypes>
            <li>WorkType_Mining</li>
            <li>WorkType_Construction</li>
            <li>WorkType_Growing</li>
            <li>WorkType_Cooking</li>
            <li>WorkType_Crafting</li>
            <li>WorkType_Hauling</li>
            <li>WorkType_Cleaning</li>
            <li>WorkType_Research</li>
        </allowedWorkTypes>
        <disabledWorkTypes/>
        <skillMin>1</skillMin>
        <skillMax>8</skillMax>
        <!-- AI属性 -->
        <thinkTreeDefName>ThinkTree_Humanlike</thinkTreeDefName>
        <fleeHealthThreshold>0.3</fleeHealthThreshold>
        <canFlee>true</canFlee>
    </PawnKindDef>
    
    <PawnKindDef>
